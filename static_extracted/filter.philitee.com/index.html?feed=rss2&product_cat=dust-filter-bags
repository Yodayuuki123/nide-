</ul>]]></description>
										<content:encoded><![CDATA[		<div data-elementor-type="product-post" data-elementor-id="2339" class="elementor elementor-2339" data-elementor-post-type="product">
				<div class="elementor-element elementor-element-f78310d e-flex e-con-boxed e-con e-parent" data-id="f78310d" data-element_type="container">
