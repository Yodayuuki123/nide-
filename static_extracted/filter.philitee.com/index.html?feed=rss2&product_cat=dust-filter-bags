										<img loading="lazy" decoding="async" width="200" height="200" src="https://filter.philitee.com/wp-content/uploads/2024/11/PTFE-Membrane-Treat-详情3.jpg" class="attachment-large size-large wp-image-2379" alt="" srcset="https://filter.philitee.com/wp-content/uploads/2024/11/PTFE-Membrane-Treat-详情3.jpg 200w, https://filter.philitee.com/wp-content/uploads/2024/11/PTFE-Membrane-Treat-详情3-150x150.jpg 150w, https://filter.philitee.com/wp-content/uploads/2024/11/PTFE-Membrane-Treat-详情3-100x100.jpg 100w" sizes="(max-width: 200px) 100vw, 200px" />											<figcaption class="widget-image-caption wp-caption-text">PTFE Membrane</figcaption>
