		<title>PTFE Staple Fibers</title>
		<link>https://filter.philitee.com/?product=ptfe-staple-fibers</link>
					<comments>https://filter.philitee.com/?product=ptfe-staple-fibers#respond</comments>
		
		<dc:creator><![CDATA[wpdc@20248]]></dc:creator>
