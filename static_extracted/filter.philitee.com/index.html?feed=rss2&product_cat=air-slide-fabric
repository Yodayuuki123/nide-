							<table><tbody><tr><td id="sjs-A1" colspan="2" data-t="s" data-v="Product Name">Product Name</td><td id="sjs-C1" colspan="3" data-t="s" data-v="Filament Polyester Air slide Fabric">Filament Polyester Air slide Fabric</td></tr><tr><td id="sjs-A2" colspan="2" data-t="s" data-v="Thickness( mm)">Thickness( mm)</td><td id="sjs-C2" data-t="s" data-v="4">4</td><td id="sjs-D2" data-t="s" data-v="5">5</td><td id="sjs-E2" data-t="s" data-v="6">6</td></tr><tr><td id="sjs-A3" colspan="2" data-t="s" data-v="Gram Weight( gsm)">Gram Weight( gsm)</td><td id="sjs-C3" data-t="s" data-v="3300">3300</td><td id="sjs-D3" data-t="s" data-v="3900">3900</td><td id="sjs-E3" data-t="s" data-v="4400">4400</td></tr><tr><td id="sjs-A4" colspan="2" data-t="s" data-v="Air permeability( L/m-.s)">Air permeability( L/m².s )</td><td id="sjs-C4" data-t="s" data-v="90">90</td><td id="sjs-D4" data-t="s" data-v="85">85</td><td id="sjs-E4" data-t="s" data-v="80">80</td></tr><tr><td id="sjs-A5" colspan="2" data-t="s" data-v="Tensile strength(kg/cm?)">Tensile strength(kg/cm²)</td><td id="sjs-C5" style="box-sizing: inherit; margin: 0px; padding: 4px; border-width: 1px 0px 1px 1px; border-image: initial; outline: 0px; font-variant: inherit; font-stretch: inherit; line-height: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: top; font-family: inherit; font-size: 14px; font-style: inherit; font-weight: normal; text-align: left; white-space: normal; min-width: 100px; border-color: #e8eaec initial #e9e9e9 #e8eaec; border-style: solid initial solid solid;" data-t="s" data-v="&gt; 450">&gt; 450</td><td id="sjs-D5" style="box-sizing: inherit; margin: 0px; padding: 4px; border-width: 1px 0px 1px 1px; border-image: initial; outline: 0px; font-variant: inherit; font-stretch: inherit; line-height: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-featu