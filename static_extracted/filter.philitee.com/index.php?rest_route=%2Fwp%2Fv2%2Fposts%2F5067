{"id":5067,"date":"2024-12-06T14:42:12","date_gmt":"2024-12-06T06:42:12","guid":{"rendered":"http:\/\/filter.philitee.com\/?p=5067"},"modified":"2024-12-06T17:05:00","modified_gmt":"2024-12-06T09:05:00","slug":"filter-cloth-selection-guide","status":"publish","type":"post","link":"https:\/\/filter.philitee.com\/?p=5067","title":{"rendered":"Filter Cloth Selection Guide"},"content":{"rendered":"\t\t<div data-elementor-type=\"wp-post\" data-elementor-id=\"5067\" class=\"elementor elementor-5067\" data-elementor-post-type=\"post\">\n\t\t\t\t<div class=\"elementor-element elementor-element-2c65bfe e-con-full e-flex e-con e-parent\" data-id=\"2c65bfe\" data-element_type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-e02a8c6 elementor-widget elementor-widget-image\" data-id=\"e02a8c6\" data-element_type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<img fetchpriority=\"high\" decoding=\"async\" width=\"1024\" height=\"768\" src=\"https:\/\/filter.philitee.com\/wp-content\/uploads\/2024\/12\/\u5de5\u5382-scaled-p1-1024x768.jpg\" class=\"attachment-large size-large wp-image-5068\" alt=\"\" srcset=\"https:\/\/filter.philitee.com\/wp-content\/uploads\/2024\/12\/\u5de5\u5382-scaled-p1-1024x768.jpg 1024w, https:\/\/filter.philitee.com\/wp-content\/uploads\/2024\/12\/\u5de5\u5382-scaled-p1-300x225.jpg 300w, https:\/\/filter.philitee.com\/wp-content\/uploads\/2024\/12\/\u5de5\u5382-scaled-p1-768x576.jpg 768w, https:\/\/filter.philitee.com\/wp-content\/uploads\/2024\/12\/\u5de5\u5382-scaled-p1-1536x1152.jpg 1536w, https:\/\/filter.philitee.com\/wp-content\/uploads\/2024\/12\/\u5de5\u5382-scaled-p1-2048x1536.jpg 2048w, https:\/\/filter.philitee.com\/wp-content\/uploads\/2024\/12\/\u5de5\u5382-scaled-p1-1320x990.jpg 1320w, https:\/\/filter.philitee.com\/wp-content\/uploads\/2024\/12\/\u5de5\u5382-scaled-p1-600x450.jpg 600w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" \/>\t\t\t\